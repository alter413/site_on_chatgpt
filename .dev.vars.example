# Copy to .dev.vars only for local Wrangler testing. Never commit real values.
# Generate with Python secrets.token_urlsafe(32); there is no default password.
OWNER_PASSWORD=
BOT_API_URL=https://bot-api.your-domain.com
BOT_ADMIN_TOKEN=replace-with-the-token-used-by-your-python-bot
# Optional: service token for an additional Access application protecting the Tunnel
# BOT_ACCESS_CLIENT_ID=
# BOT_ACCESS_CLIENT_SECRET=
