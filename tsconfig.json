{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["vite/client", "@cloudflare/workers-types"]
  },
  "include": ["src", "functions", "server", "tests-web", "tests-e2e", "vite.config.ts", "playwright.config.ts", "vitest.config.ts"]
}
